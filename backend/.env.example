# Private backend configuration. Copy to .env and fill locally.
# A read-only connection to the existing parking_data schema is sufficient.
DATABASE_URL=
# Use a manual token OR both credentials for automatic OneMap REST renewal.
ONEMAP_ACCESS_TOKEN=
ONEMAP_EMAIL=
ONEMAP_PASSWORD=
# Leave blank for an explicit current-only baseline; otherwise run ml/service.
PARKCHOICE_MODEL_URL=http://127.0.0.1:8001
